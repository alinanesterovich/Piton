import os
import pytest
from project_api import ProjectApi


@pytest.fixture(scope="session")
def api_client():
    """
    Создаёт клиент API.
    Токен и базовый URL берутся из переменных окружения, чтобы не хранить их в коде.
    Наставнику нужно будет задать переменные: YOUGILE_TOKEN и YOUGILE_BASE_URL.
    """
    base_url = os.getenv("YOUGILE_BASE_URL", "https://yougile.com/api-v2")
    token = os.getenv("YOUGILE_TOKEN")
    if not token:
        pytest.fail(
            "Не задан токен YouGile. Установите переменную окружения YOUGILE_TOKEN."
        )
    return ProjectApi(base_url, token)


